# Contains the OpenSea API key (.env) and the SQLite sales DB. Stays on this machine.
sales database/

# Misc
.DS_Store
*.log
npm-debug.log*

# Syncthing machine-local files (not synced between devices)
.stfolder/
.stignore

# Claude Code per-machine permission allowlist. Local-only by design, and this
